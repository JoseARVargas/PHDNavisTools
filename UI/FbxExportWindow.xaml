<Window x:Class="PHDNavisTools.UI.FbxExportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Exportar FBX por Sets  |  PHD Eng. Digital"
        Width="520" Height="620"
        MinWidth="400" MinHeight="500"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResizeWithGrip">

    <Window.Resources>
        <Style TargetType="GroupBox">
            <Setter Property="Margin" Value="0,4,0,4"/>
            <Setter Property="Padding" Value="8,4"/>
        </Style>
    </Window.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>     <!-- Sets tree -->
            <RowDefinition Height="Auto"/>  <!-- Pasta de destino -->
            <RowDefinition Height="Auto"/>  <!-- Progresso -->
            <RowDefinition Height="Auto"/>  <!-- Botões -->
            <RowDefinition Height="Auto"/>  <!-- Diagnóstico (expansível) -->
        </Grid.RowDefinitions>

        <!-- ===== Sets ===== -->
        <GroupBox Grid.Row="0" Header="Search Sets e Selection Sets (selecione os que deseja exportar)">
            <DockPanel>
                <Grid DockPanel.Dock="Top" Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" Content="Selecionar todos" Height="24" Padding="8,0"
                            Margin="0,0,4,0" Click="BtnSelectAll_Click"/>
                    <Button Grid.Column="1" Content="Desmarcar todos" Height="24" Padding="8,0"
                            Margin="0,0,4,0" Click="BtnDeselectAll_Click"/>
                    <Button Grid.Column="3" Content="Atualizar" Width="80" Height="24"
                            Click="BtnRefresh_Click"/>
                </Grid>

                <TreeView x:Name="TreeSets" BorderBrush="#CCC" BorderThickness="1">
                    <TreeView.ItemContainerStyle>
                        <Style TargetType="TreeViewItem">
                            <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
                            <Setter Property="Padding"    Value="2,1"/>
                        </Style>
                    </TreeView.ItemContainerStyle>
                    <TreeView.ItemTemplate>
                        <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                            <StackPanel Orientation="Horizontal" Margin="0,1">
                                <CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay}"
                                          IsThreeState="False" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                <TextBlock Text="{Binding TypeIcon}" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding Name}" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding CountLabel}" Foreground="#888" FontSize="10"
                                           Margin="4,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </HierarchicalDataTemplate>
                    </TreeView.ItemTemplate>
                </TreeView>
            </DockPanel>
        </GroupBox>

        <!-- ===== Pasta de destino ===== -->
        <GroupBox Grid.Row="1" Header="Pasta de destino">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="TxtFolder" Grid.Column="0" Height="26"
                         VerticalContentAlignment="Center" Padding="4,0" Margin="0,0,6,0"
                         IsReadOnly="True" Background="#F5F5F5" BorderBrush="#CCC"/>
                <Button Grid.Column="1" Content="..." Width="30" Height="26"
                        Click="BtnBrowse_Click" ToolTip="Escolher pasta"/>
            </Grid>
        </GroupBox>

        <!-- ===== Progresso ===== -->
        <StackPanel Grid.Row="2" Margin="0,2,0,2">
            <ProgressBar x:Name="PbExport" Height="14" Minimum="0" Maximum="100" Value="0"
                         Margin="0,0,0,3" Visibility="Collapsed"/>
            <TextBlock x:Name="TxtStatus" FontSize="11" Foreground="#555"
                       TextWrapping="Wrap" Visibility="Collapsed"/>
        </StackPanel>

        <!-- ===== Botões ===== -->
        <Grid Grid.Row="3" Margin="0,6,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Button Grid.Column="1" x:Name="BtnExport" Content="Exportar FBX"
                    Width="120" Height="28" Margin="0,0,8,0" IsDefault="True"
                    Click="BtnExport_Click"/>
            <Button Grid.Column="2" x:Name="BtnClose" Content="Fechar"
                    Width="90" Height="28" IsCancel="True" Click="BtnClose_Click"/>
        </Grid>

        <!-- ===== Diagnóstico (expansível) ===== -->
        <Expander Grid.Row="4" Margin="0,6,0,0" IsExpanded="False">
            <Expander.Header>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Diagnóstico" VerticalAlignment="Center"/>
                    <Button Grid.Column="1" Content="Limpar" Width="52" Height="18"
                            FontSize="10" Padding="4,0" Click="BtnClearLog_Click"
                            VerticalAlignment="Center"/>
                </Grid>
            </Expander.Header>
            <TextBox x:Name="TxtLog"
                     Height="140"
                     IsReadOnly="True"
                     TextWrapping="NoWrap"
                     VerticalScrollBarVisibility="Auto"
                     HorizontalScrollBarVisibility="Auto"
                     FontFamily="Consolas" FontSize="10"
                     Background="#1E1E1E" Foreground="#D4D4D4"
                     BorderBrush="#555" Padding="6,4"/>
        </Expander>
    </Grid>
</Window>
