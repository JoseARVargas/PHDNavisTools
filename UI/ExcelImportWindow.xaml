<Window x:Class="NavisworksIfcExporter.UI.ExcelImportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Importar Dados do Excel — PHD"
        Width="560" SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize" MinHeight="480" MaxHeight="820">

    <Window.Resources>
        <Style TargetType="GroupBox">
            <Setter Property="Margin" Value="0,4,0,4"/>
            <Setter Property="Padding" Value="8,6"/>
        </Style>
        <Style TargetType="Label">
            <Setter Property="Padding" Value="0,2"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Height" Value="24"/>
            <Setter Property="Margin" Value="0,2"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Height" Value="24"/>
            <Setter Property="Margin" Value="0,2"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <StackPanel Margin="12">

        <!-- Arquivo Excel -->
        <GroupBox Header="Arquivo Excel">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="110"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Label Grid.Row="0" Grid.Column="0" Content="Arquivo:"/>
                <TextBox x:Name="TxtFilePath" Grid.Row="0" Grid.Column="1"
                         IsReadOnly="True" Background="#F5F5F5"/>
                <Button Grid.Row="0" Grid.Column="2" Content="Procurar..." Width="80" Height="24"
                        Margin="6,2,0,2" Click="BtnBrowse_Click"/>

                <Label Grid.Row="1" Grid.Column="0" Content="Planilha:"/>
                <ComboBox x:Name="CmbSheet" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2"
                          SelectionChanged="CmbSheet_SelectionChanged"/>

                <Label Grid.Row="2" Grid.Column="0" Content="Coluna chave:"/>
                <ComboBox x:Name="CmbExcelKey" Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2"
                          IsEditable="True" ToolTip="Coluna do Excel que identifica unicamente cada elemento"/>
            </Grid>
        </GroupBox>

        <!-- Chave no Modelo -->
        <GroupBox Header="Chave no Modelo (correspondência com coluna chave do Excel)">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="110"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Label Grid.Row="0" Grid.Column="0" Content="Categoria:"/>
                <ComboBox x:Name="CmbModelCategory" Grid.Row="0" Grid.Column="1"
                          IsEditable="True" SelectionChanged="CmbModelCategory_SelectionChanged"
                          ToolTip="Categoria/aba de propriedades do modelo (ex: 'Elemento', 'IFC')"/>
                <Button Grid.Row="0" Grid.Column="2" Content="Escanear" Width="80" Height="24"
                        Margin="6,2,0,2" Click="BtnScanModel_Click"
                        ToolTip="Escaneia o modelo para listar categorias e propriedades disponíveis"/>

                <Label Grid.Row="1" Grid.Column="0" Content="Propriedade:"/>
                <ComboBox x:Name="CmbModelProperty" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2"
                          IsEditable="True"
                          ToolTip="Nome da propriedade cujo valor será comparado com a coluna chave do Excel"/>

                <Label Grid.Row="2" Grid.Column="0" Content="Escopo:"/>
                <StackPanel Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2"
                            Orientation="Horizontal" Margin="0,4">
                    <RadioButton x:Name="RbFullModel" Content="Modelo completo"
                                 IsChecked="True" Margin="0,0,16,0"/>
                    <RadioButton x:Name="RbSelection" Content="Apenas seleção atual"/>
                </StackPanel>
            </Grid>
        </GroupBox>

        <!-- Colunas a importar -->
        <GroupBox Header="Colunas a Importar">
            <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                    <Button Content="Marcar todas" Width="100" Height="22" Margin="0,0,8,0"
                            Click="BtnSelectAll_Click"/>
                    <Button Content="Limpar" Width="80" Height="22"
                            Click="BtnClearAll_Click"/>
                </StackPanel>
                <Border BorderThickness="1" BorderBrush="#CCCCCC" CornerRadius="2">
                    <ListBox x:Name="LstColumns" Height="120" BorderThickness="0"
                             SelectionMode="Multiple"
                             ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <CheckBox Content="{Binding Name}"
                                          IsChecked="{Binding IsChecked, Mode=TwoWay}"
                                          Margin="2,1"/>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Border>
                <TextBlock x:Name="TxtColInfo" Text="Selecione um arquivo primeiro."
                           FontSize="11" Foreground="#888" Margin="0,4,0,0"/>
            </StackPanel>
        </GroupBox>

        <!-- Destino -->
        <GroupBox Header="Destino no Modelo">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="110"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Label Grid.Column="0" Content="Nome da aba:"/>
                <TextBox x:Name="TxtTargetTab" Grid.Column="1" Text="PHD_Excel"
                         ToolTip="Nome da aba customizada onde os dados serão gravados (visível no painel Properties)"/>
            </Grid>
        </GroupBox>

        <!-- Progresso -->
        <Grid x:Name="PanelProgress" Visibility="Collapsed" Margin="0,4,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="50"/>
            </Grid.ColumnDefinitions>
            <ProgressBar x:Name="PrgBar" Grid.Column="0" Height="18" Minimum="0" Maximum="100"/>
            <TextBlock x:Name="TxtPct" Grid.Column="1" Text="" HorizontalAlignment="Center"
                       VerticalAlignment="Center" FontSize="11"/>
        </Grid>

        <!-- Log -->
        <TextBox x:Name="TxtLog"
                 Height="90" IsReadOnly="True"
                 FontFamily="Consolas" FontSize="11"
                 Background="#1E1E1E" Foreground="#9CCA7E"
                 TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                 Visibility="Collapsed" Margin="0,4,0,0"
                 BorderThickness="0"/>

        <!-- Botões -->
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button x:Name="BtnImport" Content="Importar" Width="110" Height="28"
                    Margin="0,0,8,0" IsDefault="True" Click="BtnImport_Click"/>
            <Button Content="Fechar" Width="90" Height="28"
                    IsCancel="True" Click="BtnClose_Click"/>
        </StackPanel>

    </StackPanel>
</Window>
