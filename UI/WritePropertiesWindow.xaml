<Window x:Class="NavisworksIfcExporter.UI.WritePropertiesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Escrever Propriedades — PHD"
        Width="460" SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize">

    <Window.Resources>
        <Style TargetType="GroupBox">
            <Setter Property="Margin" Value="0,4,0,4"/>
            <Setter Property="Padding" Value="8,6"/>
        </Style>
        <Style TargetType="Label">
            <Setter Property="Padding" Value="0,2"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Height" Value="24"/>
            <Setter Property="Margin" Value="0,2"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Height" Value="24"/>
            <Setter Property="Margin" Value="0,2"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <StackPanel Margin="12">

        <!-- Seleção -->
        <Border Background="#EEF4FB" CornerRadius="4" Padding="8,6" Margin="0,0,0,6">
            <TextBlock x:Name="TxtSelectionInfo" Text="Nenhum elemento selecionado."
                       FontWeight="SemiBold" FontSize="12"/>
        </Border>

        <!-- Aba de propriedades -->
        <GroupBox Header="Aba de propriedades">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="110"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Label Grid.Row="0" Grid.Column="0" Content="Aba existente:"/>
                <ComboBox x:Name="CmbTab" Grid.Row="0" Grid.Column="1"
                          IsEditable="True" IsTextSearchEnabled="True"
                          SelectionChanged="CmbTab_SelectionChanged"
                          PreviewTextInput="CmbTab_PreviewTextInput"/>

                <Label Grid.Row="1" Grid.Column="0" Content="Nova aba:"
                       Foreground="#666" FontSize="11"/>
                <TextBox x:Name="TxtNewTab" Grid.Row="1" Grid.Column="1"
                         Visibility="Collapsed"/>
            </Grid>
        </GroupBox>

        <!-- Nome da propriedade -->
        <GroupBox Header="Propriedade">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="110"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Label Grid.Row="0" Grid.Column="0" Content="Nome:"/>
                <ComboBox x:Name="CmbProperty" Grid.Row="0" Grid.Column="1"
                          IsEditable="True" IsTextSearchEnabled="True"/>
            </Grid>
        </GroupBox>

        <!-- Valor -->
        <GroupBox Header="Valor">
            <TextBox x:Name="TxtValue" Height="24"/>
        </GroupBox>

        <!-- Log -->
        <TextBox x:Name="TxtLog" Height="52" IsReadOnly="True"
                 FontFamily="Consolas" FontSize="11" Background="#F8F8F8"
                 TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                 Visibility="Collapsed" Margin="0,0,0,6"/>

        <!-- Botões -->
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,6,0,0">
            <Button x:Name="BtnApply" Content="Aplicar" Width="90" Height="28"
                    Margin="0,0,8,0" IsDefault="True" Click="BtnApply_Click"/>
            <Button Content="Fechar" Width="90" Height="28"
                    IsCancel="True" Click="BtnClose_Click"/>
        </StackPanel>

    </StackPanel>
</Window>
