<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <OutputType>Library</OutputType>
    <AssemblyName>NavisworksIfcExporter</AssemblyName>
    <RootNamespace>NavisworksIfcExporter</RootNamespace>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <LangVersion>9.0</LangVersion>
    <!-- Exclui pasta de testes da compilação do plugin principal -->
    <DefaultItemExcludes>$(DefaultItemExcludes);Tests\**</DefaultItemExcludes>
    <!-- Detecta automaticamente Navisworks 2025–2027; sobrescreva com -p:NavisworksDir="..." -->
    <!-- Checa a presença do DLL de API (não só a pasta) e prefere a mais antiga para max compatibilidade -->
    <NavisworksDir Condition="'$(NavisworksDir)' == '' AND Exists('C:\Program Files\Autodesk\Navisworks Manage 2025\Autodesk.Navisworks.Api.dll')">C:\Program Files\Autodesk\Navisworks Manage 2025</NavisworksDir>
    <NavisworksDir Condition="'$(NavisworksDir)' == '' AND Exists('C:\Program Files\Autodesk\Navisworks Manage 2026\Autodesk.Navisworks.Api.dll')">C:\Program Files\Autodesk\Navisworks Manage 2026</NavisworksDir>
    <NavisworksDir Condition="'$(NavisworksDir)' == '' AND Exists('C:\Program Files\Autodesk\Navisworks Manage 2027\Autodesk.Navisworks.Api.dll')">C:\Program Files\Autodesk\Navisworks Manage 2027</NavisworksDir>
  </PropertyGroup>

  <!-- Permite que o projeto de testes acesse membros internos -->
  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>NavisworksIfcExporter.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Resources\exportar_ifc_32x32.png"/>
    <Resource Include="Resources\exportar_ifc_searchset_32x32.png"/>
    <Resource Include="Resources\exportar_clash_results_32x32.png"/>
    <Resource Include="Resources\exportar_fbx_sets_32x32.png"/>
    <Resource Include="Resources\exportar_selecao_ifc_32x32.png"/>
    <Resource Include="Resources\verificar_propriedades_32x32.png"/>
    <Resource Include="Resources\auto_attach_qto_32x32.png"/>
    <Resource Include="Resources\realcar_selecao_32x32.png"/>
    <Resource Include="Resources\restaurar_aparencia_32x32.png"/>
    <Resource Include="Resources\escrever_propriedades_32x32.png" Condition="Exists('Resources\escrever_propriedades_32x32.png')"/>
  </ItemGroup>

  <ItemGroup>
    <!-- Leitura de Excel sem dependência do Office -->
    <PackageReference Include="ExcelDataReader" Version="3.7.0"/>
    <PackageReference Include="ExcelDataReader.DataSet" Version="3.7.0"/>
  </ItemGroup>

  <!-- Copia o DLL para todas as versões do Navisworks instaladas (só em Debug) -->
  <Target Name="DeployToNavisworks2027" AfterTargets="Build"
          Condition="'$(Configuration)' == 'Debug' AND Exists('C:\Program Files\Autodesk\Navisworks Manage 2027')">
    <PropertyGroup>
      <PluginDir27>$(APPDATA)\Autodesk\Navisworks Manage 2027\Plugins\NavisworksIfcExporter</PluginDir27>
    </PropertyGroup>
    <MakeDir Directories="$(PluginDir27)" Condition="!Exists('$(PluginDir27)')" />
    <Copy SourceFiles="$(OutputPath)$(AssemblyName).dll" DestinationFolder="$(PluginDir27)" SkipUnchangedFiles="true" />
    <Message Text="Plugin copiado para $(PluginDir27)" Importance="high" />
  </Target>

  <Target Name="DeployToNavisworks2026" AfterTargets="Build"
          Condition="'$(Configuration)' == 'Debug' AND Exists('C:\Program Files\Autodesk\Navisworks Manage 2026')">
    <PropertyGroup>
      <PluginDir26>$(APPDATA)\Autodesk\Navisworks Manage 2026\Plugins\NavisworksIfcExporter</PluginDir26>
    </PropertyGroup>
    <MakeDir Directories="$(PluginDir26)" Condition="!Exists('$(PluginDir26)')" />
    <Copy SourceFiles="$(OutputPath)$(AssemblyName).dll" DestinationFolder="$(PluginDir26)" SkipUnchangedFiles="true" />
    <Message Text="Plugin copiado para $(PluginDir26)" Importance="high" />
  </Target>

  <Target Name="DeployToNavisworks2025" AfterTargets="Build"
          Condition="'$(Configuration)' == 'Debug' AND Exists('C:\Program Files\Autodesk\Navisworks Manage 2025')">
    <PropertyGroup>
      <PluginDir25>$(APPDATA)\Autodesk\Navisworks Manage 2025\Plugins\NavisworksIfcExporter</PluginDir25>
    </PropertyGroup>
    <MakeDir Directories="$(PluginDir25)" Condition="!Exists('$(PluginDir25)')" />
    <Copy SourceFiles="$(OutputPath)$(AssemblyName).dll" DestinationFolder="$(PluginDir25)" SkipUnchangedFiles="true" />
    <Message Text="Plugin copiado para $(PluginDir25)" Importance="high" />
  </Target>

  <!-- Microsoft.CSharp é necessário para 'dynamic' em projetos SDK-style net48 -->
  <ItemGroup>
    <Reference Include="Microsoft.CSharp" />
  </ItemGroup>

  <!-- Referências ao Navisworks (não copiadas para output) -->
  <ItemGroup>
    <Reference Include="Autodesk.Navisworks.Api">
      <HintPath>$(NavisworksDir)\Autodesk.Navisworks.Api.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="Autodesk.Navisworks.ComApi">
      <HintPath>$(NavisworksDir)\Autodesk.Navisworks.ComApi.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="Autodesk.Navisworks.Interop.ComApi">
      <HintPath>$(NavisworksDir)\Autodesk.Navisworks.Interop.ComApi.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="AdWindows">
      <HintPath>$(NavisworksDir)\AdWindows.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="Autodesk.Navisworks.Clash">
      <HintPath>$(NavisworksDir)\Autodesk.Navisworks.Clash.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="Autodesk.Navisworks.Takeoff">
      <HintPath>$(NavisworksDir)\Autodesk.Navisworks.Takeoff.dll</HintPath>
      <Private>False</Private>
    </Reference>
  </ItemGroup>

</Project>
